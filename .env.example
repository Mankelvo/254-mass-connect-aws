# Copy to .env for local development or the approved EC2 setup. Never commit .env.
PORT=4000
NODE_ENV=development
# Production: NODE_ENV=production. Node binds only to 127.0.0.1.
# Vite's development proxy expects PORT=4000.
# Set only for a separately hosted trusted frontend; same-origin needs no CORS setting.
# CORS_ORIGIN=https://your-domain.example

# Local means server-side JSON/files, not browser localStorage.
# All storage is currently local. AWS_REGION, DDB_MEMBERS_TABLE and S3_PHOTO_BUCKET
# do NOT activate AWS adapters. Use an EC2 IAM role when adapters are implemented;
# never put access keys in frontend variables or this file.
# Join submissions: .data/join-submissions.json (fixed path, single Node process).

# Optional event configuration; relative overrides resolve from the working directory.
# EVENTS_FILE=server/data/events.json
# EVENTS_DATA_DIR=.data/events
# EVENT_PHOTO_DIR=.data/community-photos/events

# Gallery catalog and local storage; the shipped catalog is empty.
# public-images references public/images/, which Vite copies into the public build.
# Catalog approval does not restrict access to those static files.
# GALLERY_CATALOG=server/data/photos.json
# GALLERY_PHOTO_DIR=.data/community-photos
# Home uses photo-free placeholders; its former preview endpoint returns 404.
