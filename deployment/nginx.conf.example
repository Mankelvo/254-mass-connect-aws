# Example ONLY: adapt the domain/path/security to your actual EC2 deployment.
# Configure TLS and CloudFront origin access restrictions before production.
server {
    listen 80;
    server_name _;
    root /var/www/254-mass-connect/dist;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20k;
    }

    location /assets/ { try_files $uri =404; expires 7d; add_header Cache-Control "public"; }
    location / { try_files $uri $uri/ /index.html; }
}
